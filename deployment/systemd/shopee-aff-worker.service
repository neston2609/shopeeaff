[Unit]
Description=Shopee Aff Durable Video Worker
After=network-online.target shopee-aff-backend.service
[Service]
User=shopeeaff
Group=shopeeaff
WorkingDirectory=/app/shopeeaff/backend
EnvironmentFile=/etc/shopee-aff-ai-studio/production.env
ExecStart=/app/shopeeaff/.venv/bin/python -m app.worker
Restart=always
RestartSec=4
TimeoutStopSec=60
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/shopee-aff-ai-studio
UMask=0027
[Install]
WantedBy=multi-user.target

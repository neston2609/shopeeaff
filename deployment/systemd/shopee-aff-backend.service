[Unit]
Description=Shopee Aff FastAPI
After=network-online.target
[Service]
User=shopeeaff
Group=shopeeaff
WorkingDirectory=/app/shopeeaff/backend
EnvironmentFile=/etc/shopee-aff-ai-studio/production.env
ExecStart=/app/shopeeaff/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8100 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=4
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/shopee-aff-ai-studio
UMask=0027
[Install]
WantedBy=multi-user.target
